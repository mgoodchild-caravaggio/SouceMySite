{
  "name": "hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed:generate": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/generate-seed.mjs --log-level=warning && node node_modules/.cache/generate-seed.mjs",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.28.0",
    "serve": "14.2.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0",
    "typescript": "5.6.3",
    "vite": "6.4.5"
  }
}
